# Frontend environment variables
# Copy to .env.local for local development

# Backend base URL.
# Local: leave empty to use Vite proxy or set http://localhost:8080
# Vercel: set this to your Render backend URL (for example: https://seat-pakki-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8080

# Stripe publishable key fallback for client-side initialization
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
