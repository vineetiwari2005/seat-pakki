# ===================================
# Database Configuration
# ===================================
DB_USERNAME=springuser
DB_PASSWORD=springpass123

# ===================================
# Admin Credentials (seeded on startup)
# ===================================
MAIN_ADMIN_EMAIL=admin@gmail.com
MAIN_ADMIN_PASSWORD=password123

THEATRE_ADMIN_EMAIL=tadmin@gmail.com
THEATRE_ADMIN_PASSWORD=password123

# ===================================
# JWT Configuration
# ===================================
JWT_SECRET=YourSuperSecureRandomJwtSecretKeyHere

# ===================================
# Email Configuration (Gmail SMTP)
# ===================================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===================================
# Stripe Payment Gateway (Test Mode)
# Get keys from: https://dashboard.stripe.com/test/apikeys
# ===================================
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ===================================
# OTP SMS Providers (India)
# Keep at least ONE configured
# ===================================
TEXTLOCAL_API_KEY=your_textlocal_api_key_here
TEXTLOCAL_SENDER=TXTLCL
TWOFACTOR_API_KEY=your_2factor_api_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TEXTBELT_API_KEY=textbelt
CIRCUITDIGEST_API_KEY=your_circuitdigest_api_key_here
CIRCUITDIGEST_SMS_URL=https://www.circuitdigest.cloud/api/send-sms
